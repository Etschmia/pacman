{
  "name": "pacman-clone",
  "version": "1.0.0",
  "description": "Modern Pac-Man clone with Phaser 3 and TypeScript",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run --exclude '**/*.pbt.test.ts'",
    "test:pbt": "vitest run --include '**/*.pbt.test.ts'",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "phaser": "^3.70.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "fast-check": "^4.6.0",
    "typescript": "^5.3.0",
    "vite": "^8.0.1",
    "vitest": "^4.1.0"
  }
}
